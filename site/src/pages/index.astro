---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import { difficultyLabels, getCategories, getQuestions } from "../lib/content";

const questions = getQuestions();
const categories = getCategories();
const base = import.meta.env.BASE_URL;
const totals = {
  easy: questions.filter((question) => question.difficulty === "easy").length,
  medium: questions.filter((question) => question.difficulty === "medium").length,
  hard: questions.filter((question) => question.difficulty === "hard").length
};
---

<BaseLayout
  title="AI Interview"
  description="面向 Agent 应用开发岗位求职者的中文开源面试题库。"
>
  <div class="page-shell">
    <SiteHeader />

    <main id="main-content">
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero-kicker"><span>OPEN QUESTION BANK</span><span>VOL. 01</span></div>
        <div class="hero-grid">
          <div class="hero-copy">
            <p class="eyebrow">为真实工程能力准备</p>
            <h1 id="hero-title">把 Agent<br /><em>讲清楚</em></h1>
            <p class="hero-intro">
              不背概念，不堆术语。从架构取舍到故障排查，用真问题检验你能否设计、实现与维护 Agent 应用。
            </p>
          </div>

          <div class="hero-dashboard" aria-label="题库统计">
            <div class="total-block">
              <span class="total-number">{String(questions.length).padStart(2, "0")}</span>
              <span class="total-label">道<br />题目</span>
            </div>
            <div class="difficulty-tally">
              <div><span>{totals.easy}</span><small>初级 EASY</small></div>
              <div><span>{totals.medium}</span><small>中级 MEDIUM</small></div>
              <div><span>{totals.hard}</span><small>高级 HARD</small></div>
            </div>
            <div class="category-count">{categories.length} 个知识分类 <span aria-hidden="true">↗</span></div>
          </div>
        </div>
      </section>

      <section class="question-browser" aria-labelledby="question-list-title">
        <div class="browser-heading">
          <div>
            <p class="section-index">01 / QUESTION INDEX</p>
            <h2 id="question-list-title">选一道题，开始回答</h2>
          </div>
          <p>建议先自己组织答案，<br />再对照参考思路。</p>
        </div>

        <div class="toolbar">
          <label class="search-box" for="question-search">
            <span aria-hidden="true">⌕</span>
            <input
              id="question-search"
              type="search"
              placeholder="搜索题目、答案或关键词…"
              autocomplete="off"
            />
            <kbd>/</kbd>
          </label>

          <div class="filter-group" aria-label="按分类筛选">
            <span class="filter-label">CATEGORY</span>
            <button class="filter-chip is-active" type="button" data-filter-type="category" data-filter-value="all" aria-pressed="true">全部</button>
            {categories.map((category) => (
              <button class="filter-chip" type="button" data-filter-type="category" data-filter-value={category} aria-pressed="false">
                {category}
              </button>
            ))}
          </div>

          <div class="filter-group" aria-label="按难度筛选">
            <span class="filter-label">LEVEL</span>
            <button class="filter-chip is-active" type="button" data-filter-type="difficulty" data-filter-value="all" aria-pressed="true">全部</button>
            {Object.entries(difficultyLabels).map(([value, label]) => (
              <button class="filter-chip" type="button" data-filter-type="difficulty" data-filter-value={value} aria-pressed="false">
                {label}
              </button>
            ))}
          </div>
        </div>

        <div class="result-bar">
          <p id="result-count" aria-live="polite">显示 <strong>{questions.length}</strong> 道题</p>
          <button id="clear-filters" class="clear-button" type="button" disabled>清除筛选 ×</button>
        </div>

        <div class="question-list" id="question-list">
          {questions.map((question, index) => (
            <article
              class="question-card"
              data-question-card
              data-search={question.searchText.toLocaleLowerCase("zh-CN")}
              data-categories={JSON.stringify(question.categories)}
              data-difficulty={question.difficulty}
              style={`--card-index: ${index}`}
            >
              <a href={`${base}questions/${question.id}/`} aria-label={`查看题目：${question.title}`}>
                <span class="question-number">Q{String(index + 1).padStart(2, "0")}</span>
                <div class="question-content">
                  <div class="question-meta">
                    {question.categories.map((category) => <span>{category}</span>)}
                    <span class={`level level-${question.difficulty}`}>{difficultyLabels[question.difficulty]}</span>
                  </div>
                  <h3>{question.title}</h3>
                  <p>{question.description}</p>
                </div>
                <span class="card-arrow" aria-hidden="true">↗</span>
              </a>
            </article>
          ))}
        </div>

        <div class="empty-state" id="empty-state" hidden>
          <span>00</span>
          <h3>没有找到匹配的题目</h3>
          <p>试试其他关键词，或者清除当前筛选。</p>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <p>AI INTERVIEW / AGENT APPLICATION ENGINEERING</p>
      <p>内容采用 CC BY 4.0 许可·社区共建</p>
    </footer>
  </div>

  <script>
    const searchInput = document.querySelector<HTMLInputElement>("#question-search");
    const cards = [...document.querySelectorAll<HTMLElement>("[data-question-card]")];
    const resultCount = document.querySelector<HTMLElement>("#result-count");
    const emptyState = document.querySelector<HTMLElement>("#empty-state");
    const clearButton = document.querySelector<HTMLButtonElement>("#clear-filters");
    const filterButtons = [...document.querySelectorAll<HTMLButtonElement>("[data-filter-type]")];

    const state = { category: "all", difficulty: "all", query: "" };

    function applyFilters() {
      const normalizedQuery = state.query.trim().toLocaleLowerCase("zh-CN");
      let visible = 0;

      cards.forEach((card) => {
        const categories = JSON.parse(card.dataset.categories ?? "[]") as string[];
        const matchesQuery = !normalizedQuery || card.dataset.search?.includes(normalizedQuery);
        const matchesCategory = state.category === "all" || categories.includes(state.category);
        const matchesDifficulty = state.difficulty === "all" || card.dataset.difficulty === state.difficulty;
        const matches = Boolean(matchesQuery && matchesCategory && matchesDifficulty);
        card.hidden = !matches;
        if (matches) visible += 1;
      });

      if (resultCount) resultCount.innerHTML = `显示 <strong>${visible}</strong> 道题`;
      if (emptyState) emptyState.hidden = visible !== 0;
      if (clearButton) clearButton.disabled = !state.query && state.category === "all" && state.difficulty === "all";
    }

    function resetFilterButtons() {
      filterButtons.forEach((button) => {
        const active = button.dataset.filterValue === state[button.dataset.filterType as "category" | "difficulty"];
        button.classList.toggle("is-active", active);
        button.setAttribute("aria-pressed", String(active));
      });
    }

    searchInput?.addEventListener("input", () => {
      state.query = searchInput.value;
      applyFilters();
    });

    filterButtons.forEach((button) => {
      button.addEventListener("click", () => {
        const type = button.dataset.filterType as "category" | "difficulty";
        state[type] = button.dataset.filterValue ?? "all";
        resetFilterButtons();
        applyFilters();
      });
    });

    clearButton?.addEventListener("click", () => {
      state.query = "";
      state.category = "all";
      state.difficulty = "all";
      if (searchInput) searchInput.value = "";
      resetFilterButtons();
      applyFilters();
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "/" && document.activeElement !== searchInput) {
        event.preventDefault();
        searchInput?.focus();
      }
      if (event.key === "Escape" && document.activeElement === searchInput) {
        searchInput.value = "";
        state.query = "";
        searchInput.blur();
        applyFilters();
      }
    });
  </script>
</BaseLayout>
